{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(npm run typecheck)",
      "Shell(npm test)",
      "Shell(npm run build)"
    ],
    "deny": [
      "Shell(git)",
      "Shell(git *)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(.github/**)"
    ]
  }
}
